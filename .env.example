# Chave de segurança interna / Master Key que protege o proxy de acessos não autorizados
INTERNAL_API_KEY=minha_chave_secreta_123

# IP de escuta (use 0.0.0.0 para todas as interfaces ou amarre ao IP da VPN, ex: 10.8.0.5)
BIND_IP=0.0.0.0

# Porta exposta no host
PORT=8000

# URL do servidor Lovable MCP
LOVABLE_MCP_URL=https://mcp.lovable.dev

# URL do servidor Uscreen MCP
USCREEN_MCP_URL=https://app.uscreen.tv/mcp

# (Opcional) URL pública HTTPS se estiver atrás de proxy reverso (Nginx/Caddy/Cloudflare)
# Exemplo: https://mcp.encomendafacil.shop
PUBLIC_URL=https://mcp.encomendafacil.shop

# ----------------------------------------------------
# Configurações do Meta Ads App & Webhooks
# ----------------------------------------------------
# App ID e App Secret do aplicativo no Meta for Developers
META_APP_ID=seu_meta_app_id
META_APP_SECRET=seu_meta_app_secret

# Token secreto de verificação para handshake do Webhook (hub.verify_token)
META_VERIFY_TOKEN=meta_mcp_hub_token

# (Opcional) URL de Webhook para disparo proativo em N8N, Flowise ou agente autônomo
# META_AGENT_TRIGGER_URL=https://n8n.seuservidor.com/webhook/meta-alerts

# ---- Yungas (opcional: fallback para o tenant 'default'; o login por tenant é feito no painel) ----
# Credenciais fornecidas pelo suporte da Yungas (suporte@yungas.com.br)
YUNGAS_CLIENT_ID=
YUNGAS_CLIENT_SECRET=
# Escopos separados por espaço (vazio = todos os .all)
YUNGAS_SCOPES=
# production | staging
YUNGAS_ENV=production
# API Key do PEX (opcional)
YUNGAS_PEX_API_KEY=

# ---- Sults (opcional: fallback para o tenant 'default'; o cadastro por tenant é feito no painel) ----
# Tokens estáticos gerados em Segurança > API > Gestão de Tokens (v1 e v2 são independentes)
SULTS_TOKEN_V1=
SULTS_TOKEN_V2=

# ---- Omie ERP (opcional: fallback para o tenant 'default'; o cadastro por tenant é feito no painel) ----
# Credenciais geradas em Meus Aplicativos no Portal do Desenvolvedor Omie (developer.omie.com.br)
OMIE_APP_KEY=
OMIE_APP_SECRET=
