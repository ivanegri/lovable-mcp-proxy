# Chave de segurança interna / Master Key que protege o proxy de acessos não autorizados
INTERNAL_API_KEY=minha_chave_secreta_123

# IP de escuta (use 0.0.0.0 para todas as interfaces ou amarre ao IP da VPN, ex: 10.8.0.5)
BIND_IP=0.0.0.0

# Porta exposta no host
PORT=8000

# URL do servidor Lovable MCP
LOVABLE_MCP_URL=https://mcp.lovable.dev

# URL do servidor Uscreen MCP
USCREEN_MCP_URL=https://app.uscreen.tv/mcp

# (Opcional) URL pública HTTPS se estiver atrás de proxy reverso (Nginx/Caddy/Cloudflare)
# Exemplo: https://mcp.encomendafacil.shop
PUBLIC_URL=https://mcp.encomendafacil.shop
