# Chave de segurança interna que seu framework enviará no header 'x-api-key'
INTERNAL_API_KEY=minha_chave_secreta_123

# IP de escuta (use 0.0.0.0 para todas as interfaces ou amarre ao IP da VPN, ex: 10.8.0.5)
BIND_IP=0.0.0.0

# Porta exposta no host
PORT=8000

# URL do servidor Lovable MCP
LOVABLE_MCP_URL=https://mcp.lovable.dev
